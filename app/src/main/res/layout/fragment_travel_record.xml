<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="48dp"
        android:paddingBottom="0dp">

        <LinearLayout
            android:id="@+id/earthStage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/earthSlotMy"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.pnu.orbit.ui.record.EarthGlowView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.pnu.orbit.ui.record.EarthModelView
                    android:id="@+id/earthMy"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/earth_my" />

                <TextView
                    android:id="@+id/labelMy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="4dp"
                    android:elevation="12dp"
                    android:text="@string/earth_my"
                    android:textColor="@color/nebula_my"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/earthSlotFriends"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.pnu.orbit.ui.record.EarthGlowView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.pnu.orbit.ui.record.EarthModelView
                    android:id="@+id/earthFriends"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/earth_friends" />

                <TextView
                    android:id="@+id/labelFriends"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="4dp"
                    android:elevation="12dp"
                    android:text="@string/earth_friends"
                    android:textColor="@color/nebula_friends"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/earthSlotWorld"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.pnu.orbit.ui.record.EarthGlowView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.pnu.orbit.ui.record.EarthModelView
                    android:id="@+id/earthWorld"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/earth_world" />

                <TextView
                    android:id="@+id/labelWorld"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="4dp"
                    android:elevation="12dp"
                    android:text="@string/earth_world"
                    android:textColor="@color/nebula_world"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/mapPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:background="@color/orbit_surface"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/recordActions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/mapFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/mapKeyPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/orbit_surface_light"
                android:gravity="center"
                android:padding="18dp"
                android:text="@string/record_map_key_missing"
                android:textAlignment="center"
                android:textColor="@color/orbit_text_secondary"
                android:textSize="13sp" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tripRecyclerView"
            android:layout_width="0dp"
            android:layout_height="176dp"
            android:layout_marginBottom="8dp"
            android:alpha="0"
            android:background="@color/orbit_surface_scrim"
            android:clipToPadding="false"
            android:padding="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/recordActions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/recordActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <Button
                android:id="@+id/buttonToggleTrips"
                style="@style/Widget.Orbit.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="@string/travel_list" />

            <Button
                android:id="@+id/buttonAddTrip"
                style="@style/Widget.Orbit.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/add_trip" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/photoDetailOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_polaroid_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/photoDetailImage"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@color/black"
                android:clickable="true"
                android:contentDescription="@string/section_photos"
                android:focusable="true"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/photoDetailComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#FF202124"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/photoDetailDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FF5F6368"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/photoDetailPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FF5F6368"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Full, uncropped photo shown when the detail thumbnail is tapped again. -->
    <FrameLayout
        android:id="@+id/fullPhotoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/fullPhotoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/section_photos"
            android:scaleType="fitCenter" />
    </FrameLayout>
</FrameLayout>
