<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbit_space"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingTop="56dp"
    android:paddingEnd="20dp">

    <ImageButton
        android:id="@+id/btnBackToGenerate"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/generatedTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_input"
        android:hint="Itinerary title"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="@color/orbit_text_secondary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBackToGenerate"
        app:layout_constraintEnd_toStartOf="@+id/btnApprovePlan"
        app:layout_constraintStart_toEndOf="@id/btnBackToGenerate"
        app:layout_constraintTop_toTopOf="@id/btnBackToGenerate" />

    <Button
        android:id="@+id/btnApprovePlan"
        style="@style/Widget.Orbit.Button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:minWidth="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Save"
        app:layout_constraintBottom_toBottomOf="@id/btnBackToGenerate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBackToGenerate" />

    <LinearLayout
        android:id="@+id/savedActionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBackToGenerate">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditPlan"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:contentDescription="Edit"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeletePlan"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Delete"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/plannerStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/orbit_text_secondary"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/savedActionBar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleMap"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Map"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/savedActionBar" />

    <FrameLayout
        android:id="@+id/plannerMapPanel"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnToggleMap">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/plannerMapFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/plannerMapKeyPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/orbit_surface_light"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/record_map_key_missing"
            android:textAlignment="center"
            android:textColor="@color/orbit_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dayPlanPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/plannerMapPanel" />

    <TextView
        android:id="@+id/dayArrowLeft"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="&lt;"
        android:textColor="@color/orbit_brand_magenta"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/dayPlanPager"
        app:layout_constraintTop_toTopOf="@id/dayPlanPager" />

    <TextView
        android:id="@+id/dayArrowRight"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="&gt;"
        android:textColor="@color/orbit_brand_magenta"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/dayPlanPager"
        app:layout_constraintTop_toTopOf="@id/dayPlanPager" />
</androidx.constraintlayout.widget.ConstraintLayout>
