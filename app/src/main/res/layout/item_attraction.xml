<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#2D3545"
    app:cardBackgroundColor="@color/orbit_surface_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Left Side: Photo Container with CardView for rounded corners -->
        <androidx.cardview.widget.CardView
            android:id="@+id/attractionCardImageContainer"
            android:layout_width="90dp"
            android:layout_height="90dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="@color/orbit_surface"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/attractionImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:contentDescription="Attraction Image" />

                <!-- Sequence Badge -->
                <TextView
                    android:id="@+id/attractionSequence"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|top"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_attraction_sequence"
                    android:gravity="center"
                    android:textColor="@color/orbit_space"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Right Side: Details -->
        <!-- Attraction Name -->
        <TextView
            android:id="@+id/attractionName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/attractionCardImageContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonBar" />

        <!-- Button Bar (Top Right) -->
        <LinearLayout
            android:id="@+id/buttonBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnMoveUp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_up"
                android:contentDescription="Move Up"
                app:tint="@color/orbit_primary" />

            <ImageButton
                android:id="@+id/btnMoveDown"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_down"
                android:contentDescription="Move Down"
                app:tint="@color/orbit_primary" />

            <ImageButton
                android:id="@+id/btnMoveDay"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_move_day"
                android:contentDescription="Move to another Day"
                app:tint="@color/orbit_primary" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:contentDescription="Delete"
                app:tint="#FF6B6B" />
        </LinearLayout>

        <!-- Time Planning layout -->
        <LinearLayout
            android:id="@+id/timeLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/attractionCardImageContainer"
            app:layout_constraintTop_toBottomOf="@id/attractionName"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Toggles for Precise / Approx -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvModePrecise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_time_chip_unselected"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="정확한 시간"
                    android:textColor="@color/orbit_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvModeApprox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_time_chip_unselected"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="대략적 시간"
                    android:textColor="@color/orbit_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Time Text (Click to Edit) -->
            <TextView
                android:id="@+id/tvTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_time_chip_unselected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="시간 입력하기"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
