<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/orbit_surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/orbit_brand" />
            <corners android:radius="12dp" />
            <padding
                android:left="14dp"
                android:top="12dp"
                android:right="14dp"
                android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/orbit_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/orbit_outline" />
            <corners android:radius="12dp" />
            <padding
                android:left="14dp"
                android:top="12dp"
                android:right="14dp"
                android:bottom="12dp" />
        </shape>
    </item>
</selector>
